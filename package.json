{
  "name": "railvaani",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "web": "npm run start -w @railvaani/web",
    "api": "npm run dev -w @railvaani/api",
    "build": "npm run build -w @railvaani/train-core && npm run build -w @railvaani/split-engine && npm run build -w @railvaani/web",
    "test:engine": "npm run build -w @railvaani/train-core && npm test -w @railvaani/split-engine",
    "e2e": "npm run e2e -w @railvaani/e2e",
    "build:pages": "npm run build -w @railvaani/train-core && npm run build -w @railvaani/split-engine && npm run build -w @railvaani/web -- --configuration production --base-href=/railvaani/",
    "test:web": "tsx --test apps/web/src/app/services/voice-intent.service.spec.ts apps/web/src/app/shared/search-params.spec.ts apps/web/src/app/shared/leg-times.spec.ts apps/web/src/app/shared/split-notes.spec.ts"
  },
  "devDependencies": {},
  "overrides": {
    "@angular/core": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/animations": "20.3.34"
  }
}
